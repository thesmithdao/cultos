{
  "name": "@cultos/cli",
  "version": "0.3.2",
  "description": "Repository work for the agent economy.",
  "type": "module",
  "bin": {
    "cult": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx src/cli.ts",
    "sibyl:memory": "node --import tsx integrations/sibyl-memory/index.ts status",
    "sibyl:memory:record": "node --import tsx integrations/sibyl-memory/index.ts record",
    "sibyl:memory:recall": "node --import tsx integrations/sibyl-memory/index.ts recall",
    "sibyl:memory:history": "node --import tsx integrations/sibyl-memory/index.ts history",
    "sibyl:memory:reset": "node --import tsx integrations/sibyl-memory/index.ts reset",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "virtuals",
    "acp",
    "github",
    "gitlawb",
    "agents",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesmithdao/cultos.git"
  },
  "homepage": "https://github.com/thesmithdao/cultos#readme",
  "bugs": {
    "url": "https://github.com/thesmithdao/cultos/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
