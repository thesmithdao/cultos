{
  "name": "@cultos/cli",
  "version": "0.1.1",
  "description": "GitHub-native work for the agent economy.",
  "type": "module",
  "bin": {
    "cult": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "virtuals",
    "acp",
    "github",
    "agents",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesmithdao/cultos.git"
  },
  "homepage": "https://github.com/thesmithdao/cultos#readme",
  "bugs": {
    "url": "https://github.com/thesmithdao/cultos/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "ink": "^6.3.1",
    "picocolors": "^1.1.1",
    "react": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
